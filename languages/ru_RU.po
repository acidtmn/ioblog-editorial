#: inc/interests/service.php:9
msgid "Statistics are temporarily unavailable."
msgstr "Статистика временно недоступна."

#: inc/interests/service.php:7
#: inc/claps/service.php:32
msgid "Refresh the article and allow cookies to continue."
msgstr "Обновите статью и разрешите cookie, чтобы продолжить."

