#: inc/claps/service.php:42
msgid "Too many requests. Please wait and try again."
msgstr "Слишком много запросов. Подождите и попробуйте снова."

#: inc/interests/view-template.php:5
msgid "Support, bookmarks, and topics readers could not find."
msgstr "Поддержка, закладки и темы, которых читатели не нашли."

#: inc/interests/view-template.php:5
#: inc/interests/view.php:6
msgid "Publishing and readership"
msgstr "Публикации и читатели"

#: inc/interests/view-template.php:6
msgid "Articles readers support"
msgstr "Статьи, которые поддерживают"

#: inc/interests/view-template.php:7
msgid "Counts represent browsers, not verified people. Order prioritizes supporters, then bookmarks and claps. Anonymous statistics are approximate."
msgstr "Счётчики отражают браузеры, а не подтверждённых людей. Приоритет сортировки: поддержавшие, закладки, хлопки. Анонимная статистика приблизительна."

#: inc/interests/view-template.php:8
msgid "Collection is disabled. Enable it in Publishing and readership to begin. Existing data is preserved."
msgstr "Сбор выключен. Включите его в разделе «Публикации и читатели». Ранее собранные данные сохраняются."

#: inc/interests/view-template.php:9
msgid "Article"
msgstr "Статья"

#: inc/interests/view-template.php:9
#: template-parts/claps.php:21
msgid "Supporters"
msgstr "Поддержали"

#: inc/interests/view-template.php:9
#: template-parts/claps.php:21
msgid "Claps"
msgstr "Хлопки"

#: inc/interests/view-template.php:9
#: template-parts/library.php:9
msgid "Bookmarks"
msgstr "Закладки"

#: inc/interests/view-template.php:9
